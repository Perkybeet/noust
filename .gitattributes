# .gitattributes
# Control what gets included in git archive (used for source tarballs)

# Exclude development and CI files
.github/ export-ignore
.gitignore export-ignore
.gitattributes export-ignore

# Exclude build and test files
Makefile export-ignore
pytest.ini export-ignore
tests/ export-ignore
Dockerfile* export-ignore
# The central's image recipe ships: it is a product artefact, not a test fixture.
packaging/container/Dockerfile -export-ignore
docker/ export-ignore
docker-compose*.yml export-ignore
# A product of its own, published from a repository of its own (docs/terraform-registry.md): the
# packages do not carry its Go source, and a build host has no network to fetch its modules.
terraform-provider-noust/ export-ignore

# Exclude documentation for developers (keep README.md and docs/)
build-and-upload-obs.sh export-ignore

# Keep these for distribution builds
# obs/ - needed for Debian/Ubuntu packages
# rpm/ - needed for RPM packages
# src/ - the actual source code
# README.md - user documentation
# LICENSE - required
# setup.py - needed for builds
# pyproject.toml - needed for builds
# docs/ - user documentation

# Design research, specs and plans are for contributors, not for packages
