#!/usr/bin/make -f

export PYBUILD_NAME=noust
export DH_VERBOSE=1

# python3-questionary is packaged from Debian 13 and Ubuntu 24.04 on. Where it
# is not, recommending it is worse than useless: apt's upgrade keeps back any
# upgrade that would newly install a package whose Recommends it cannot
# satisfy. The build root is the target release, so its os-release says which
# one this is.
NOUST_RECOMMENDS := $(shell grep -qsE '^VERSION_CODENAME=(bookworm|jammy)$$' /etc/os-release || echo python3-questionary)

%:
	dh $@ --with python3 --buildsystem=pybuild

# Everything below reads from the source tree, never from debian/ beyond what
# OBS puts there. OBS builds debian/ only from the files named debian.* in the
# package (debtransform), so a file the rules expected as debian/<name> was
# silently missing on OBS: the package once shipped a config.yaml uploaded by
# hand years earlier, which still enabled the AI monitor removed in 1.x.
override_dh_auto_install:
	dh_auto_install
	# Create apps directory
	install -d debian/noust/var/www/apps
	# Create log directory
	install -d debian/noust/var/log/noust
	# The default configuration, as a reference only. Nothing is installed
	# under /etc/noust: noust writes the file itself, 0600 in a 0700
	# directory, when it first needs it.
	install -Dm644 obs/noust.default.yaml \
		debian/noust/usr/share/noust/config.example.yaml
	# The installer, for a central that enrolls a server with no Noust on it
	# (noust fleet enroll): it sends this copy over the connection.
	install -Dm644 packaging/install.sh debian/noust/usr/share/noust/install.sh
	# The manual. dh_compress gzips the page.
	install -Dm644 man/noust.1 debian/noust/usr/share/man/man1/noust.1
	# Shell completion. Committed, not generated here: Click's
	# scripts contain no command names, so they cannot drift, and running
	# Python during the build would make every runtime import a build
	# dependency. That is what failed all twenty-two OBS targets.
	install -Dm644 src/noust/completions/noust.bash \
		debian/noust/usr/share/bash-completion/completions/noust
	install -Dm644 src/noust/completions/_noust \
		debian/noust/usr/share/zsh/vendor-completions/_noust
	install -Dm644 src/noust/completions/noust.fish \
		debian/noust/usr/share/fish/vendor_completions.d/noust.fish

override_dh_gencontrol:
	dh_gencontrol -- '-Vnoust:Recommends=$(NOUST_RECOMMENDS)'

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_auto_test:
	@echo "Skipping tests during package build"
