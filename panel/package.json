{
  "name": "noust-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:screens": "NOUST_SCREENS=1 playwright test",
    "docs:screens": "NOUST_DOCS_SCREENS=1 playwright test docs.spec.ts && python3 ../scripts/docs_screens.py write",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "check:api": "node scripts/check-api.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "i18n:new": "node scripts/i18n.mjs new",
    "i18n:status": "node scripts/i18n.mjs status",
    "i18n:missing": "node scripts/i18n.mjs missing",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:routes": "node scripts/i18n-routes.mjs",
    "design:baseline": "UPDATE_DESIGN_BASELINE=1 vitest run src/styles/design-rules.test.ts src/styles/design-structure.test.ts src/i18n/glossary.test.ts",
    "ux:counts": "node scripts/ux-counts.mjs",
    "screens": "node scripts/screens.mjs",
    "screens:shell": "node scripts/shell-screens.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/mona-sans": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "3.14.22",
    "lucide-react": "1.61.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
