{
  # Reference: join-lemmy.org/docs/administration/configuration.html
  setup: {
    admin_username: "admin"
    admin_password: "${ADMIN_PASSWORD}"
    site_name: "Lemmy"
  }
  database: {
    host: "db"
    port: 5432
    user: "lemmy"
    password: "${DB_PASSWORD}"
    database: "lemmy"
    pool_size: 10
  }
  hostname: "${FQDN}"
  bind: "0.0.0.0"
  port: 8536
  pictrs: {
    url: "http://pictrs:8080/"
    api_key: "${PICTRS_KEY}"
  }
}
