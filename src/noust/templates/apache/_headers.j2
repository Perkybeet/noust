{#
    The response headers a site sends (see nginx/_headers.j2). Rendered on its
    own, without the web server manager, a template falls back to the defaults.
#}
{% if response_headers is defined %}
{% for name, value in response_headers %}
    Header always set {{ name }} "{{ value }}"
{% endfor %}
{% else %}
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
{% if ssl and hsts %}
    Header always set Strict-Transport-Security "{{ hsts }}"
{% endif %}
{% endif %}
