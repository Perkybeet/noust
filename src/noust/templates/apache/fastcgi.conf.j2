# Apache PHP-FPM site configuration for {{ domain }}
# Generated by Noust

# Do not announce the Apache version or the modules in headers and error pages.
# Server-wide, so every site file says the same thing.
ServerTokens Prod
ServerSignature Off
{% include "_redirects.j2" %}

<VirtualHost *:80>
    ServerName {{ domain }}
{% if server_aliases %}
    ServerAlias {{ server_aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

    # ACME challenge location for Let's Encrypt (webroot method). An alias is
    # resolved before anything below can claim the path, so the front
    # controller and the hidden-files rule never see it.
    Alias /.well-known/acme-challenge/ /var/www/html/.well-known/acme-challenge/
    <Directory /var/www/html/.well-known/acme-challenge/>
        Options None
        AllowOverride None
        Require all granted
    </Directory>

{% if ssl %}
    # Redirect HTTP to HTTPS (except ACME challenges)
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ domain }}
{% if server_aliases %}
    ServerAlias {{ server_aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

    # SSL Configuration
    SSLEngine on
    SSLCertificateFile {{ ssl_certificate | default('/etc/letsencrypt/live/' + domain + '/fullchain.pem') }}
    SSLCertificateKeyFile {{ ssl_certificate_key | default('/etc/letsencrypt/live/' + domain + '/privkey.pem') }}

    # SSL Settings
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder off
    SSLSessionTickets off

{% endif %}
    # Document root. On releases this goes through the ``current`` link, so a
    # switch of ``current`` reaches the next request without a reload of Apache.
    DocumentRoot {{ document_root }}
    DirectoryIndex index.php index.html

    # Uploads (WordPress media, CMS attachments) are held in PHP too.
    LimitRequestBody {{ max_upload_bytes }}

    # Logging
    ErrorLog ${APACHE_LOG_DIR}/{{ domain }}.error.log
    CustomLog ${APACHE_LOG_DIR}/{{ domain }}.access.log combined

    <Directory {{ document_root }}>
        Options -Indexes +FollowSymLinks
        # A .htaccess is never read, as nginx never read one: what a CMS keeps
        # there is the front controller's job below.
        AllowOverride None
        Require all granted

        # Front controller: a path that is not a file goes to index.php.
        FallbackResource /index.php
    </Directory>

    # Security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
{% if ssl and hsts %}
    Header always set Strict-Transport-Security "{{ hsts }}"
{% endif %}

{% for pattern in deny_patterns %}
    <LocationMatch "^/{{ pattern }}$">
        Require all denied
    </LocationMatch>

{% endfor %}
    # Hidden files and directories (.env, .git, .htaccess), except
    # /.well-known/ (security.txt, apple-app-site-association, a renewal's ACME check).
    <LocationMatch "/\.(?!well-known(?:/|$))">
        Require all denied
    </LocationMatch>

    # Dependency manifests and vendored code are never served, nor run.
    <LocationMatch "(?i)^/(?:composer\.(?:json|lock)|vendor/)">
        Require all denied
    </LocationMatch>

    # A PHP file in an upload directory is somebody's payload, never code the
    # application shipped: it is refused before it can reach PHP.
    <LocationMatch "(?i)/(?:uploads|files)/.*\.php$">
        Require all denied
    </LocationMatch>

    # Only .php reaches PHP (below); every other PHP extension would be sent as
    # text, source and credentials included, so it is refused instead.
    <LocationMatch "(?i)\.(?:phtml|phar|php[0-9]|inc)$">
        Require all denied
    </LocationMatch>

    # What an installation leaves lying around: logs (WordPress's debug.log),
    # database dumps, editor and backup copies of the configuration. None of it
    # is ever a page or an asset.
    <LocationMatch "(?i)(?:\.(?:log|sql|sqlite3?|bak|backup|old|orig|save|swp|swo|dist)|~)$">
        Require all denied
    </LocationMatch>

    # PHP runs in this application's own pool, over its socket.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:{{ fastcgi_socket }}|fcgi://localhost"
    </FilesMatch>
    ProxyTimeout 300

    # Cache static assets
    <FilesMatch "\.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|avif|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Compression
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml
    </IfModule>
</VirtualHost>
