# Apache reverse proxy configuration for {{ domain }}
# Generated by Noust

# Do not announce the Apache version or the modules in headers and error pages.
# Server-wide, so every site file says the same thing.
ServerTokens Prod
ServerSignature Off
{% include "_redirects.j2" %}
{#
    One pair of virtual hosts per group of names: the application's own, and one
    for each port a name is proxied to apart from it.
#}
{% set groups = [{"name": server_primary | default(domain), "aliases": server_aliases | default([]), "port": port}] %}
{% for extra in port_servers | default([]) %}
{% set _ = groups.append({"name": extra.names.split()[0], "aliases": extra.names.split()[1:], "port": extra.port}) %}
{% endfor %}

{% for group in groups %}
<VirtualHost *:80>
    ServerName {{ group.name }}
{% if group.aliases %}
    ServerAlias {{ group.aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

{% if ssl %}
    # Redirect HTTP to HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ group.name }}
{% if group.aliases %}
    ServerAlias {{ group.aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

    # SSL Configuration
    SSLEngine on
    SSLCertificateFile {{ ssl_certificate | default('/etc/letsencrypt/live/' + domain + '/fullchain.pem') }}
    SSLCertificateKeyFile {{ ssl_certificate_key | default('/etc/letsencrypt/live/' + domain + '/privkey.pem') }}
    
    # SSL Settings
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder off
    SSLSessionTickets off

{% endif %}
{% include "_policy.j2" %}
    # Logging
    ErrorLog ${APACHE_LOG_DIR}/{{ domain }}.error.log
{% include "_log_format.j2" %}    CustomLog ${APACHE_LOG_DIR}/{{ domain }}.access.log noust_{{ domain }}

    # Security headers
{% include "_headers.j2" %}

    # Proxy settings
    ProxyPreserveHost On
    ProxyRequests Off
    
    ProxyPass / http://127.0.0.1:{{ group.port }}/
    ProxyPassReverse / http://127.0.0.1:{{ group.port }}/

    # WebSocket support
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) "ws://127.0.0.1:{{ group.port }}/$1" [P,L]

    # Timeouts
    ProxyTimeout 60
</VirtualHost>{% if not loop.last %}


{% endif %}
{% endfor %}