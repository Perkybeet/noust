# Apache reverse proxy configuration for {{ domain }}
# Generated by Noust

# Do not announce the Apache version or the modules in headers and error pages.
# Server-wide, so every site file says the same thing.
ServerTokens Prod
ServerSignature Off
{% include "_redirects.j2" %}
{#
    One pair of virtual hosts per group of names (``servers``, worked out by the web server
    manager): the application's own, one for each port a name is proxied to apart from it, and
    one for each name that holds a certificate of its own.
#}

{% for server in servers %}
<VirtualHost *:80>
    ServerName {{ server.primary }}
{% if server.aliases %}
    ServerAlias {{ server.aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

{% if ssl %}
    # Redirect HTTP to HTTPS
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</VirtualHost>

<VirtualHost *:443>
    ServerName {{ server.primary }}
{% if server.aliases %}
    ServerAlias {{ server.aliases | join(' ') }}
{% endif %}
    ServerAdmin webmaster@{{ domain }}

    # SSL Configuration
    SSLEngine on
    SSLCertificateFile {{ server.ssl_certificate }}
    SSLCertificateKeyFile {{ server.ssl_certificate_key }}
    
    # SSL Settings
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder off
    SSLSessionTickets off

{% endif %}
{% include "_policy.j2" %}
    # Logging
    ErrorLog ${APACHE_LOG_DIR}/{{ domain }}.error.log
{% include "_log_format.j2" %}    CustomLog ${APACHE_LOG_DIR}/{{ domain }}.access.log noust_{{ domain }}

    # Security headers
{% include "_headers.j2" %}

    # Proxy settings
    ProxyPreserveHost On
    ProxyRequests Off
    
    ProxyPass / http://127.0.0.1:{{ server.port or port }}/
    ProxyPassReverse / http://127.0.0.1:{{ server.port or port }}/

    # WebSocket support
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/?(.*) "ws://127.0.0.1:{{ server.port or port }}/$1" [P,L]

    # Timeouts
    ProxyTimeout 60
</VirtualHost>{% if not loop.last %}


{% endif %}
{% endfor %}