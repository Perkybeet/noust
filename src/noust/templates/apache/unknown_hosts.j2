# What answers a request for a name no site here serves. Apache gives it to the
# first virtual host it reads, and this file's name sorts before the others. The
# webroot the certificate authority is sent to still answers.
<VirtualHost *:80>
    ServerName noust-unknown-host.invalid
    DocumentRoot /var/www/html

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
{% if action == "redirect" %}
    RewriteRule ^ {{ redirect_to }} [R=301,L]
{% elif action == "refuse" %}
    RewriteRule ^ - [R=503,L]
{% else %}
    RewriteRule ^ - [R=421,L]
{% endif %}
</VirtualHost>
