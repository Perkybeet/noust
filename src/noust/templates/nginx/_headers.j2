{#
    The response headers a site sends: the security defaults, an operator's
    overrides, HSTS and noindex, all worked out by the web server manager
    (noust.managers.site_policy.response_headers). Rendered on its own, without
    the manager, a template falls back to the defaults.
#}
{% if response_headers is defined %}
{% set header_vars = (policy | default({})).header_vars | default({}) %}
{% for name, value in response_headers %}
{% if name in header_vars %}
    add_header {{ name }} ${{ header_vars[name] }} always;
{% else %}
    add_header {{ name }} "{{ value }}" always;
{% endif %}
{% endfor %}
{% set sent = response_headers | map('first') | list %}
{% for name, variable in header_vars.items() %}
{% if name not in sent %}
    add_header {{ name }} ${{ variable }} always;
{% endif %}
{% endfor %}
{% else %}
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
{% if ssl and hsts %}
    add_header Strict-Transport-Security "{{ hsts }}" always;
{% endif %}
{% endif %}
