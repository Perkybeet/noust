{#
    What the site's policy says in the server block that serves the application
    (noust.managers.site_policy.policy_context): the real client address behind
    a CDN, who may reach it, and how fast. Renders nothing for a site without one.
#}
{% set rules = policy | default({}) %}
{% if rules.http3 and ssl %}

    # HTTP/3 over QUIC beside HTTPS (the socket's own site holds reuseport)
    listen 443 quic;
    listen [::]:443 quic;
    http3 on;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
{% endif %}
{% if rules.client_certs and ssl %}

    # Only a visitor with a certificate this site's own authority signed gets in: the check is
    # the TLS handshake, before any HTTP
    ssl_client_certificate {{ rules.client_certs.ca }};
    ssl_verify_client on;
    ssl_verify_depth 1;
{% if rules.client_certs.revoked %}
    if (${{ rules.client_certs.variable }}) {
        return 403;
    }
{% endif %}
{% endif %}
{% if rules.waf %}

    # Web application firewall: the OWASP Core Rule Set, whose rules are loaded once for every
    # site (00-noust-waf)
    modsecurity on;
{% if rules.waf.mode == 'detect' %}
    modsecurity_rules 'SecRuleEngine DetectionOnly';
{% endif %}
{% if rules.waf.exclusions %}
    modsecurity_rules 'SecRuleRemoveById {{ rules.waf.exclusions | join(" ") }}';
{% endif %}
{% endif %}
{% if rules.real_ip %}

    # Client address: believed from these networks only
{% for network in rules.real_ip.proxies %}
    set_real_ip_from {{ network }};
{% endfor %}
    real_ip_header {{ rules.real_ip.header }};
{% if rules.real_ip.recursive %}
    real_ip_recursive on;
{% endif %}
{% endif %}
{% if rules.auth or rules.ip_rules or rules.forward_auth %}

    # Who may reach the site
{% if rules.ways_in | default(0) >= 2 %}
    satisfy {{ rules.satisfy }};
{% endif %}
{% for rule in rules.ip_rules | default([]) %}
    {{ rule }};
{% endfor %}
{% if rules.auth %}
{% if rules.auth.variable %}
    auth_basic ${{ rules.auth.variable }};
{% else %}
    auth_basic "{{ rules.auth.realm }}";
{% endif %}
    auth_basic_user_file {{ rules.auth.file }};
{% endif %}
{% if rules.forward_auth %}
    auth_request /_noust_auth;
{% for item in rules.forward_auth.headers %}
    auth_request_set ${{ item.variable }} ${{ item.source }};
{% endfor %}
    auth_request_set $noust_fa_cookie $upstream_http_set_cookie;
    add_header Set-Cookie $noust_fa_cookie always;
{% if rules.forward_auth.sign_in %}
    error_page 401 = @noust_signin;
{% endif %}

    # The service that answers for the visitors; only nginx itself can reach it
    location = /_noust_auth {
        internal;
        proxy_pass {{ rules.forward_auth.url }};
{% if rules.forward_auth.https %}
        proxy_ssl_server_name on;
{% endif %}
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URL $scheme://$host$request_uri;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Uri $request_uri;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }
{% if rules.forward_auth.sign_in %}

    location @noust_signin {
        internal;
        return 302 {{ rules.forward_auth.sign_in }}$scheme://$host$request_uri;
    }
{% endif %}
{% endif %}
{% endif %}
{% if rules.rate or rules.conn %}

    # Limits per client address
{% if rules.rate %}
    limit_req_status 429;
    limit_req zone={{ rules.rate.zone }} burst={{ rules.rate.burst }} nodelay;
{% endif %}
{% if rules.conn %}
    limit_conn_status 429;
    limit_conn {{ rules.conn.zone }} {{ rules.conn.limit }};
{% endif %}
{% endif %}
{#
    Where a prefix of the site goes (noust.managers.site_routes): handed to another
    service on this machine, or redirected. Both come before the site's own locations,
    so a redirect's regular expression is tried before the site's. A site with one
    server block per name of its own port renders them once, for the first.
#}
{% macro proxy_to(route) %}
        proxy_pass http://127.0.0.1:{{ route.port }}{{ '/' if route.strip else '' }};
        proxy_http_version 1.1;
{% if route.strip %}
        proxy_set_header X-Forwarded-Prefix {{ route.path }};
{% endif %}

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% for item in (rules.forward_auth.headers if rules.forward_auth else []) %}
        proxy_set_header {{ item.header }} ${{ item.variable }};
{% endfor %}
{% if rules.client_certs and ssl %}
        proxy_set_header X-SSL-Client-Subject $ssl_client_s_dn;
        proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
{% endif %}

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
{% endmacro %}
{% if loop is not defined or loop.first %}
{% for route in rules.redirects | default([]) %}

    # {{ route.path }} redirects to {{ route.target }}
    location ~ {{ route.regex }} {
        return {{ route.code }} {{ route.target }}{{ '$is_args$args' if route.keep_path else '' }};
    }
{% endfor %}
{% for route in rules.proxies | default([]) %}

    # {{ route.path }} is served by the service on port {{ route.port }}
    location ^~ {{ route.path }}/ {
{{ proxy_to(route) }}    }

    location = {{ route.path }} {
{{ proxy_to(route) }}    }
{% endfor %}
{% endif %}
