{#
    The zones a site's rate and connection limits count in. Declared in the
    http context, so before the first server block, and named after the site.
#}
{% for zone in policy_zones | default([]) %}
{% if zone.directive == "limit_req_zone" %}

limit_req_zone $binary_remote_addr zone={{ zone.name }}:10m rate={{ zone.arg }};
{% else %}

limit_conn_zone $binary_remote_addr zone={{ zone.name }}:10m;
{% endif %}
{% endfor %}
{#
    What depends on the path (noust.managers.site_routes): the realm the password is
    asked under ("off" lifts it) and the response headers of a prefix. Maps live in
    the http context; the server block reads the variable they set.
#}
{% for entry in policy_maps | default([]) %}

map $uri ${{ entry.variable }} {
    default {{ entry.default }};
{% for row in entry.entries %}
    "{{ row.key }}" {{ row.value }};
{% endfor %}
}
{% endfor %}
