# Nginx reverse proxy configuration for {{ domain }}
# Generated by Noust
{% include "_log_format.j2" %}
{% include "_redirects.j2" %}
{% if upstream_file | default(none) %}

# Blue/green: the instance that serves is named in this file, which Noust
# rewrites on every activation; nothing else in this site changes.
include {{ upstream_file }};
{% endif %}
{% for relay in relay_upstreams | default([]) %}

# Zero-downtime relay: the container that serves {{ relay.service }} is named in
# this file, which Noust rewrites while it recreates the service.
upstream {{ relay.name }} {
    include {{ relay.file }};
    keepalive 64;
}
{% endfor %}
{% for zone_name, rate in (rate_limit_zones | default({})).items() %}

limit_req_zone $binary_remote_addr zone={{ zone_name }}:10m rate={{ rate }};
{% endfor %}
{% include "_policy_zones.j2" %}
{#
    One server block pair per group of names: the application's own, and one for
    each port a name is proxied to apart from it (a second listener of the
    application: an admin interface, an API on its own port).
#}
{% set groups = [{"names": server_names | default(domain), "target": upstream_name | default('127.0.0.1:' ~ port, true)}] %}
{% for extra in port_servers | default([]) %}
{% set _ = groups.append({"names": extra.names, "target": '127.0.0.1:' ~ extra.port}) %}
{% endfor %}

{% for group in groups %}
server {
    listen 80;
    listen [::]:80;
    server_name {{ group.names }};
    server_tokens off;

    # ACME challenge location for Let's Encrypt (webroot method)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
{% if not (ssl and force_https | default(true)) and policy | default({}) and policy.auth %}
        auth_basic off;
{% endif %}
{% if not (ssl and force_https | default(true)) and policy | default({}) and policy.forward_auth %}
        auth_request off;
{% endif %}
    }

{% if ssl %}
{% if force_https | default(true) %}
    # Redirect HTTP to HTTPS (except ACME challenges)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ group.names }};
    server_tokens off;
{% else %}
    # The policy does not force HTTPS: one server answers on both ports.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
{% endif %}

    # SSL Configuration
    ssl_certificate {{ ssl_certificate | default('/etc/letsencrypt/live/' + domain + '/fullchain.pem') }};
    ssl_certificate_key {{ ssl_certificate_key | default('/etc/letsencrypt/live/' + domain + '/privkey.pem') }};
    
    # SSL Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_stapling on;
    ssl_stapling_verify on;
{% endif %}
{% include "_policy.j2" %}

{% if max_body_size | default('') %}
    client_max_body_size {{ max_body_size }};

{% endif %}
    # Logging
    access_log /var/log/nginx/{{ domain }}.access.log noust_{{ domain }};
    error_log /var/log/nginx/{{ domain }}.error.log;

    # Security headers
{% include "_headers.j2" %}

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

{% for route in extra_locations | default([]) %}
{% if route.static %}
    # {{ route.path }}: files in {{ route.static }}
    location {{ route.path }} {
        alias {{ route.static }};
{% if route.cache %}
        expires {{ route.cache }};
{% endif %}
    }

{% elif route.return_code %}
    # {{ route.path }}: redirected to {{ route.return_to }}
    location {{ route.path }} {
        return {{ route.return_code }} {{ route.return_to }};
    }

{% endif %}
{% endfor %}
{% set root = root | default({}) %}
    # Proxy settings
    location / {
{% if root.rate_limit_zone %}
        limit_req zone={{ root.rate_limit_zone }} burst={{ root.rate_limit_burst }} nodelay;
{% endif %}
{% if root.max_body_size %}
        client_max_body_size {{ root.max_body_size }};
{% endif %}
        proxy_pass http://{{ group.target }};
        proxy_http_version 1.1;
        
        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% for item in (policy.forward_auth.headers if policy | default({}) and policy.forward_auth else []) %}
        proxy_set_header {{ item.header }} ${{ item.variable }};
{% endfor %}
{% if ssl and policy | default({}) and policy.client_certs %}
        proxy_set_header X-SSL-Client-Subject $ssl_client_s_dn;
        proxy_set_header X-SSL-Client-Serial $ssl_client_serial;
{% endif %}
        
        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout {{ root.send_timeout or 60 }}s;
        proxy_read_timeout {{ root.read_timeout or 60 }}s;
        
{% if root.buffering is defined and not root.buffering %}
        # Unbuffered: the response goes to the client as it is produced
        proxy_buffering off;
{% else %}
        # Buffer settings
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
{% endif %}
    }

{% if health_check is defined and health_check != '/' %}
    # Health check endpoint
    location {{ health_check }} {
        proxy_pass http://{{ group.target }}{{ health_check }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }
{% endif %}
}{% if not loop.last %}


{% endif %}
{% endfor %}