# Generated by Noust
# The one site that holds the QUIC socket for HTTP/3. nginx accepts reuseport once
# for an address and port, and QUIC needs it to work with several workers, so no
# site of an application carries it. It refuses the handshake of any name nobody
# serves. Noust writes it with the first site that turns HTTP/3 on and removes it
# with the last.
server {
    listen 443 quic reuseport;
    listen [::]:443 quic reuseport;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;
}
