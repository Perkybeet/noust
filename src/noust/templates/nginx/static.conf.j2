# Nginx static site configuration for {{ domain }}
# Generated by Noust
{% include "_log_format.j2" %}
{% include "_redirects.j2" %}
{% include "_policy_zones.j2" %}

server {
    listen 80;
    listen [::]:80;
    server_name {{ server_names | default(domain) }};
    server_tokens off;

    # ACME challenge location for Let's Encrypt (webroot method). ^~ stops
    # nginx from even considering the hidden-files regex below for this
    # path: a plain prefix location loses to any matching regex location,
    # checked in file order, and ".well-known" itself starts with a dot.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
{% if not ssl and policy | default({}) and policy.auth %}
        auth_basic off;
{% endif %}
{% if not ssl and policy | default({}) and policy.forward_auth %}
        auth_request off;
{% endif %}
    }

{% if ssl %}
    # Redirect HTTP to HTTPS (except ACME challenges)
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ server_names | default(domain) }};
    server_tokens off;

    # SSL Configuration
    ssl_certificate {{ ssl_certificate | default('/etc/letsencrypt/live/' + domain + '/fullchain.pem') }};
    ssl_certificate_key {{ ssl_certificate_key | default('/etc/letsencrypt/live/' + domain + '/privkey.pem') }};
    
    # SSL Settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_stapling on;
    ssl_stapling_verify on;
{% endif %}
{% include "_policy.j2" %}

    # Document root
    root {{ static_dir | default(app_path) }};
    index index.html index.htm;

    # Logging
    access_log /var/log/nginx/{{ domain }}.access.log noust_{{ domain }};
    error_log /var/log/nginx/{{ domain }}.error.log;

    # Security headers
{% include "_headers.j2" %}

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # SPA support - try files then fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Other well-known resources (security.txt, apple-app-site-association,
    # a renewal's ACME check, ...) must stay reachable too: ^~ here keeps
    # this whole prefix out of the hidden-files regex below, the same way
    # the acme-challenge location above does.
    location ^~ /.well-known/ {
    }

    # Deny access to hidden files and directories, except /.well-known/ above.
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
