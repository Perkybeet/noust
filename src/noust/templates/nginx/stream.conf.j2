# Noust stream {{ name }}: {{ protocol | upper }} {{ listen_port }} to {{ target }}
# Generated by Noust ('noust stream add'); changes made here are lost when it is closed.

server {
    listen {{ listen_port }}{% if udp %} udp{% endif %};
    listen [::]:{{ listen_port }}{% if udp %} udp{% endif %} ipv6only=on;
{% if not udp %}
    proxy_connect_timeout 10s;
{% endif %}
    proxy_timeout {{ timeout_seconds }}s;
{% for source in sources %}
    allow {{ source }};
{% endfor %}
{% if sources %}
    deny all;
{% endif %}
    proxy_pass {{ target }};
}
