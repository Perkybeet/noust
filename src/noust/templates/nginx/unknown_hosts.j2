# Generated by Noust
{{ "# Noust unknown hosts: action=" ~ action }}
{% if redirect_to %}
{{ "# Noust unknown hosts: redirect=" ~ redirect_to }}
{% endif %}
{{ "# Noust unknown hosts: tls=" ~ ("yes" if tls else "no") }}
{% if distribution %}
{{ "# Noust unknown hosts: distribution=" ~ distribution }}
{% endif %}

# What answers a request for a name no site here serves, so that the first site
# in the files does not. The webroot the certificate authority is sent to still
# answers, as it does in every site Noust writes.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

    location / {
{% if action == "close" %}
        return 444;
{% elif action == "refuse" %}
        return 503;
{% else %}
        return 301 {{ redirect_to }};
{% endif %}
    }
}
{% if tls %}

# No certificate speaks for a name nobody serves: the handshake is refused, and so
# is a client that sends no server name.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_reject_handshake on;
}
{% endif %}
