# Generated by Noust
# ModSecurity opens its audit log once and never reopens it, so the web server's own rotation
# (rename the file, then ask nginx to reopen the logs it writes itself) leaves the firewall
# writing to the renamed file for good. Truncating in place keeps the handle valid. The file is
# not named *.log on purpose: /etc/logrotate.d/nginx owns that pattern, and logrotate skips the
# second rule for a file two of them name. Noust writes this with the first site that turns the
# WAF on and removes it with the last.
{{ audit_log }} {
    daily
    rotate 14
    maxsize 200M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
}
