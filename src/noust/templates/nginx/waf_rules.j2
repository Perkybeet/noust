# Generated by Noust
# ModSecurity with the OWASP Core Rule Set, loaded once for every site that turns the
# WAF on. libmodsecurity reads only the plain Include directive, so the distribution's own
# owasp-crs.load (made for Apache) is not used: the files are named here.
Include {{ base }}
SecRuleEngine On
# A password typed into a form must not end up in a log, so the request body is not kept
# (parts A, B, F, H, K, Z: headers, the answer's headers, the rules that matched).
SecAuditEngine RelevantOnly
SecAuditLog {{ audit_log }}
SecAuditLogFormat JSON
SecAuditLogType Serial
SecAuditLogParts ABFHKZ
# Responses are not inspected: it costs a buffer per request for the least useful rules.
SecResponseBodyAccess Off
Include {{ setup }}
Include {{ rules }}/*.conf
