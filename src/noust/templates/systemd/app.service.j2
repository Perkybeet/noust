{% import "_escape.j2" as esc %}
# Systemd service for {{ esc.line(name) }}
# Generated by Noust

[Unit]
Description={{ esc.line(description) }}
Documentation=https://github.com/Perkybeet/noust
After=network.target
# A transient failure is retried; a hopeless one (a missing script, a missing
# binary) ends in `failed` after five starts in five minutes instead of looping
# every RestartSec forever. Deliberate starts clear the counter first.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ esc.line(user) }}
Group={{ esc.line(group | default(user)) }}
WorkingDirectory={{ esc.line(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if environment_file | default(none) %}
# Everything else, secrets included, from a file only root and the service
# account can read: this unit is world-readable, and so is systemctl show.
EnvironmentFile=-{{ esc.path(environment_file) }}
{% endif %}
{% if runtime_environment_file | default(none) %}
# What Noust says about this deployment (its URL, branch, commit and release),
# kept with the release so going back to an older one changes it too. Listed
# last so it wins over anything the file above sets under the same names.
EnvironmentFile=-{{ esc.path(runtime_environment_file) }}
{% endif %}

# Command
ExecStart={{ esc.line(command) }}

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
{% if hardening | default([]) %}

# Hardening: a read-only filesystem but for the application's own directories
# and the ones declared, no capability, a system-call filter. Change it with:
# noust app hardening
{% for directive in hardening %}
{{ esc.line(directive) }}
{% endfor %}
{% endif %}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}

# Resource limits
# The metrics tab reads memory.current and cpu.stat, which exist only while
# systemd counts; a distribution may ship with that off.
MemoryAccounting=yes
CPUAccounting=yes
# Disk and network traffic of the application (the metrics tab's I/O charts):
# io.stat exists while the io controller is on for the cgroup, and the IP
# counters while systemd counts the bytes its sockets move.
IOAccounting=yes
IPAccounting=yes
LimitNOFILE=65535
{% for directive in resource_limits | default([]) %}
{{ esc.line(directive) }}
{% endfor %}
{% if tuning | default([]) %}

# Tuning: limits and options beyond memory, CPU and tasks. Change it with:
# noust app tuning
{% for directive in tuning %}
{{ esc.line(directive) }}
{% endfor %}
{% endif %}

[Install]
WantedBy=multi-user.target
