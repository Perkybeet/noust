{% import "_escape.j2" as esc %}
# Systemd template unit for {{ esc.line(name) }}@blue and {{ esc.line(name) }}@green
# Generated by WASM
#
# Blue/green: each instance runs its own release (colors/<instance> links to
# releases/<id>) on its own port (colors/<instance>.env), so the next release
# starts and answers beside the one serving before nginx is switched to it.

[Unit]
Description={{ esc.line(description) }} (%i)
Documentation=https://github.com/Perkybeet/wasm
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ esc.line(user) }}
Group={{ esc.line(group | default(user)) }}
WorkingDirectory={{ esc.path(colors_directory) }}/%i

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if environment_file | default(none) %}
EnvironmentFile=-{{ esc.path(environment_file) }}
{% endif %}
# Listed last so it wins: the instance's own PORT, over anything the shared
# file says. Not optional: an instance without it would take its sibling's port.
EnvironmentFile={{ esc.path(colors_directory) }}/%i.env

# Command
ExecStart={{ esc.line(command) }}

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}@%i

# Resource limits, for each instance
LimitNOFILE=65535
{% for directive in resource_limits | default([]) %}
{{ esc.line(directive) }}
{% endfor %}

[Install]
WantedBy=multi-user.target
