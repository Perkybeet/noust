{% import "_escape.j2" as esc %}
# Noust automatic update timer
# Generated by Noust

[Unit]
Description=Noust automatic update timer (window {{ esc.line(window) }})

[Timer]
OnCalendar={{ esc.line(schedule) }}
{% for line in more.splitlines() %}
OnCalendar={{ esc.line(line) }}
{% endfor %}
# The run judges the clock itself; a missed look is not made up for outside the window.
Persistent=false
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
