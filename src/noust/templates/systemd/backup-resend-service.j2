{% import "_escape.j2" as esc %}
# Noust sends again the backups that were made and could not be sent
# Generated by Noust

[Unit]
Description=Noust sends again the backups that were not sent

[Service]
Type=oneshot
{# --reason is what the ENS profile asks of every change, so the timer keeps running under it. #}
ExecStart={{ esc.line(noust) }} backup resend --reason "Scheduled resend of backups that were not sent"
