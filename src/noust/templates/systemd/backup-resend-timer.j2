{% import "_escape.j2" as esc %}
# Noust timer that sends again the copies that were not sent
# Generated by Noust

[Unit]
Description=Noust backup resend timer for {{ esc.line(target) }}

[Timer]
OnCalendar={{ esc.line(schedule) }}
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
