{% import "_escape.j2" as esc %}
# Noust retention sweep of every backup policy
# Generated by Noust

[Unit]
Description=Noust retention sweep of every backup policy

[Service]
Type=oneshot
{# --reason is what the ENS profile asks of every change, so the timer keeps running under it. #}
ExecStart={{ esc.line(noust) }} backup sweep --reason "Scheduled retention sweep"
