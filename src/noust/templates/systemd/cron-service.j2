{% import "_escape.j2" as esc %}
# Noust cron job {{ esc.line(name) }}
# Generated by Noust
{# command_record is CronManager's command_comment(): the command as typed,
   JSON-quoted onto one line. It is what the console edits; ExecStart is its
   systemd-escaped form. #}
{{ esc.line(command_record) }}
{% if app_domain %}
# Application: {{ esc.line(app_domain) }}
{% endif %}
{% if service | default("") %}
# Service: {{ esc.line(service) }}
{% endif %}

[Unit]
Description=Noust cron job {{ esc.line(name) }}

[Service]
Type=oneshot
User={{ esc.line(user) }}
{% if working_directory %}
WorkingDirectory={{ esc.line(working_directory) }}
{% endif %}
{% for key, value in (environment | default({})).items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{# exec_start is built by CronManager.build_exec_start from a shlex-parsed
   argv: bare tokens or double-quoted systemd tokens, '%' always doubled.
   There is no shell anywhere in this line. #}
ExecStart={{ esc.line(exec_start) }}
{% if timeout | default("") %}
{# A oneshot unit is "activating" while its command runs, which is the state
   TimeoutStartSec bounds; RuntimeMaxSec does not apply to this type. #}
TimeoutStartSec={{ esc.line(timeout) }}
{% endif %}

StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(unit_name) }}
