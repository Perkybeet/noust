{% import "_escape.j2" as esc %}
# Noust scheduled database backup for {{ esc.line(target) }}
# Generated by Noust

[Unit]
Description=Noust scheduled database backup for {{ esc.line(target) }}

[Service]
Type=oneshot
{# ExecStart reads $ and % as its own syntax: both are doubled, so a name can
   never be expanded into anything but itself. --reason is what the ENS profile
   asks of every change, so the timer keeps running under it. #}
ExecStart={{ esc.line(noust) }} db backup-run {{ esc.line(database) | replace('$', '$$') | replace('%', '%%') }} --engine {{ esc.line(engine) | replace('$', '$$') | replace('%', '%%') }} --reason "Scheduled database backup policy"
