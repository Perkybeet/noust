{% import "_escape.j2" as esc %}
# Noust public access to the {{ esc.line(engine) }} database {{ esc.line(database) }}
# Generated by Noust
# Forwards the public port to the engine's loopback port: the engine itself is not
# reconfigured and keeps listening on the loopback only.

[Unit]
Description=Noust proxy to the {{ esc.line(engine) }} database {{ esc.line(database) }}
Requires={{ esc.line(unit) }}.socket {{ esc.line(engine_unit) }}
After={{ esc.line(unit) }}.socket {{ esc.line(engine_unit) }}

[Service]
ExecStart={{ esc.line(proxy) }} --connections-max={{ connections_max }} {{ esc.line(target) }}
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
