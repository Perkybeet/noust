{% import "_escape.j2" as esc %}
# Systemd service for Docker Compose: {{ esc.line(name) }}
# Generated by Noust

[Unit]
Description={{ esc.line(description) }}
Documentation=https://github.com/Perkybeet/noust
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory={{ esc.line(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if compose_file %}
Environment="COMPOSE_FILE={{ esc.env_value(compose_file) }}"
{% endif %}

# Commands
{# The project the store records (-p), whose name no variable can change; a stack
    that predates it leaves Compose to derive it, as it always has. #}
{% set compose = "/usr/bin/docker compose" ~ ((" -p " ~ esc.line(compose_project)) if compose_project else "") %}
{# What starts the stack is what was judged: before Compose reads the .env and the files
    that are there now, Noust resolves them as the deployment was and compares (an unrecorded
    stack passes). A start it holds back never reaches `up`, and a reload never reaches --build. #}
{% if gate %}
ExecStartPre={{ esc.line(gate) }}
{% endif %}
ExecStart={{ compose }} up -d --remove-orphans
ExecStop={{ compose }} down
{% if gate %}
ExecReload={{ esc.line(gate) }}
{% endif %}
ExecReload={{ compose }} up -d --remove-orphans --build

# Timeouts
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}

[Install]
WantedBy=multi-user.target
