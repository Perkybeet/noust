{% import "_escape.j2" as esc %}
# Systemd service for Docker Compose: {{ esc.line(name) }}
# Generated by Noust

[Unit]
Description={{ esc.line(description) }}
Documentation=https://github.com/Perkybeet/noust
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
WorkingDirectory={{ esc.line(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if compose_file %}
Environment="COMPOSE_FILE={{ esc.env_value(compose_file) }}"
{% endif %}

# Commands
{# An adopted stack keeps the project it already ran under (-p); every
    other one leaves Compose to derive it, as it always has. #}
{% set compose = "/usr/bin/docker compose" ~ ((" -p " ~ esc.line(compose_project)) if compose_project else "") %}
ExecStart={{ compose }} up -d --remove-orphans
ExecStop={{ compose }} down
ExecReload={{ compose }} up -d --remove-orphans --build

# Timeouts
TimeoutStartSec=300

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(name) }}

[Install]
WantedBy=multi-user.target
