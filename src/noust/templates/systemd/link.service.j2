{% import "_escape.j2" as esc %}
# This server's link to its central {{ esc.line(central) }}: it dials out and keeps the way open.
# Generated by Noust. Written by 'noust fleet link', removed by 'noust fleet unlink'.
# Nothing secret is written here: the key is a file only root reads, and what the
# central is given is a fleet token, over the link, never on a command line.

[Unit]
Description=Noust link to {{ esc.line(central) }}
Documentation=https://github.com/Perkybeet/noust/blob/main/docs/CENTRAL.md
Wants=network-online.target
After=network-online.target
# The link is meant to be always up: a central that is down for an hour is not a reason
# to give up on it, so systemd keeps trying however many times it has failed.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart={{ esc.line(exec_start) }}
Restart=always
RestartSec=10

# ssh dials out and forwards one loopback port; it reads two files and writes none.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
