{% import "_escape.j2" as esc %}
# Noust log shipping: sends the logs of applications to the destinations set with `noust logdrain`.
# Generated by Noust. Written by `noust logdrain add` and removed by `noust logdrain service remove`.

[Unit]
Description=Noust log shipping
Documentation=https://github.com/Perkybeet/noust/blob/main/docs/console.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment=HOME=/root USER=root LOGNAME=root PYTHONUNBUFFERED=1
WorkingDirectory=/
# A foreground loop: systemd supervises the process it started. It reads the
# journal from where each destination got to, so a restart loses nothing.
ExecStart={{ esc.line(exec_start) }}
Restart=on-failure
RestartSec=10

# It reads the journal and Noust's store and talks to the network (and to Docker for
# a stack's logs): root, but nothing else a process can reach.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=noust-logship

[Install]
WantedBy=multi-user.target
