{% import "_escape.j2" as esc %}
# Systemd template unit for the {{ esc.line(process) }} process of {{ esc.line(application) }}: {{ esc.line(base) }}@1, @2...
# Generated by Noust
#
# A process of an application that is not its web process (a queue worker, a
# scheduler): the same release, account, environment and sandbox as the web
# unit, its own command and limits, and as many copies as the application asks
# for (the instance is the copy's number).

[Unit]
Description={{ esc.line(description) }} (%i)
Documentation=https://github.com/Perkybeet/noust
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ esc.line(user) }}
Group={{ esc.line(group | default(user)) }}
WorkingDirectory={{ esc.path(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{# %i is systemd's own specifier for the copy's number: it must reach the unit as written. #}
Environment="NOUST_PROCESS={{ esc.env_value(process) }}" "NOUST_INSTANCE=%i"
{% if environment_file | default(none) %}
EnvironmentFile=-{{ esc.path(environment_file) }}
{% endif %}

# Command
ExecStart={{ esc.line(command) }}

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
{% if hardening | default([]) %}

# Hardening: a read-only filesystem but for the application's own directories
# and the ones declared, no capability, a system-call filter. Change it with:
# noust app hardening
{% for directive in hardening %}
{{ esc.line(directive) }}
{% endfor %}
{% endif %}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(base) }}@%i

# Resource limits, for each copy
MemoryAccounting=yes
CPUAccounting=yes
LimitNOFILE=65535
{% for directive in resource_limits | default([]) %}
{{ esc.line(directive) }}
{% endfor %}

[Install]
WantedBy=multi-user.target
