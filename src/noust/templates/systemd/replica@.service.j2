{% import "_escape.j2" as esc %}
# Systemd template unit for the copies of the web process of {{ esc.line(application) }}: {{ esc.line(base) }}@<port>
# Generated by Noust
#
# A copy of the application's own web process, on a port of its own (the instance is
# the port). It runs what the application's unit runs, from the same release, as the
# same account and under the same sandbox; nginx shares the traffic among the copies
# and the unit.

[Unit]
Description={{ esc.line(description) }} (%i)
Documentation=https://github.com/Perkybeet/noust
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ esc.line(user) }}
Group={{ esc.line(group | default(user)) }}
WorkingDirectory={{ esc.path(working_directory) }}

# Environment
{% for key, value in environment.items() %}
Environment="{{ esc.env_value(key) }}={{ esc.env_value(value) }}"
{% endfor %}
{% if environment_file | default(none) %}
EnvironmentFile=-{{ esc.path(environment_file) }}
{% endif %}

# Command. env sets the copy's own PORT after the files above, so a PORT in the
# application's .env cannot make two copies listen on the same port.
{# %i is systemd's own specifier for the instance, which is the port: it must reach the unit as written. #}
ExecStart=/usr/bin/env PORT=%i {{ esc.line(command) }}

# Restart policy
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
{% if hardening | default([]) %}

# Hardening: a read-only filesystem but for the application's own directories
# and the ones declared, no capability, a system-call filter. Change it with:
# noust app hardening
{% for directive in hardening %}
{{ esc.line(directive) }}
{% endfor %}
{% endif %}

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ esc.line(base) }}@%i

# Resource limits, for each copy
MemoryAccounting=yes
CPUAccounting=yes
LimitNOFILE=65535
{% for directive in resource_limits | default([]) %}
{{ esc.line(directive) }}
{% endfor %}
{% if tuning | default([]) %}

# Tuning: limits and options beyond memory, CPU and tasks. Change it with:
# noust app tuning
{% for directive in tuning %}
{{ esc.line(directive) }}
{% endfor %}
{% endif %}

[Install]
WantedBy=multi-user.target
