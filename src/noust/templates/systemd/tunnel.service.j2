{% import "_escape.j2" as esc %}
# Noust Cloudflare Tunnel {{ esc.line(name) }}
# Generated by Noust
# The connector of the tunnel. It dials out to Cloudflare, so nothing listens for it and no
# port is opened. Its token is in {{ esc.line(env_file) }}, a file only root reads: systemd
# hands it to the process, and the process runs as a user that exists only while it does.

[Unit]
Description=Noust Cloudflare Tunnel {{ esc.line(name) }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ esc.line(cloudflared) }} tunnel --no-autoupdate run
EnvironmentFile={{ esc.path(env_file) }}
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
