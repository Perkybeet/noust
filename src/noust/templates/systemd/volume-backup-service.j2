{% import "_escape.j2" as esc %}
# Noust scheduled volume backup for {{ esc.line(target) }}
# Generated by Noust

[Unit]
Description=Noust scheduled volume backup for {{ esc.line(target) }}

[Service]
Type=oneshot
{# ExecStart reads $ and % as its own syntax: both are doubled, so a name can
   never be expanded into anything but itself. --reason is what the ENS profile
   asks of every change, so the timer keeps running under it. #}
ExecStart={{ esc.line(noust) }} backup volumes run {{ esc.line(domain) | replace('$', '$$') | replace('%', '%%') }} --reason "Scheduled volume backup policy"
