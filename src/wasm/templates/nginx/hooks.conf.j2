# WASM hooks site for {{ domain }}: only /hooks/ reaches the console
# Generated by WASM ('wasm web expose-hooks'); every other path answers 404.

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};

    # ACME challenge location for Let's Encrypt (webroot method)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
        allow all;
    }

{% if ssl %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }};

    ssl_certificate {{ ssl_certificate | default('/etc/letsencrypt/live/' + domain + '/fullchain.pem') }};
    ssl_certificate_key {{ ssl_certificate_key | default('/etc/letsencrypt/live/' + domain + '/privkey.pem') }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
{% endif %}

    access_log /var/log/nginx/{{ domain }}.access.log;
    error_log /var/log/nginx/{{ domain }}.error.log;

    add_header X-Content-Type-Options "nosniff" always;

    # GitHub delivers payloads of up to 25 MB; the console caps what it reads.
    client_max_body_size 26m;

    # Only the webhook surface: never the console, its API or its sign-in.
    location /hooks/ {
        # nginx matched the normalised path; a raw one that needed normalising
        # (/api/x/../../hooks/y, %2e, %2f, %5c) is never a delivery.
        if ($request_uri ~* "^[^?]*(\.\.|%2e|%2f|%5c)") {
            return 400;
        }
        # The URI makes nginx forward the path it normalised and matched,
        # not the raw request line, which the console would route elsewhere.
        proxy_pass {{ upstream_scheme | default('http') }}://127.0.0.1:{{ port }}/hooks/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if upstream_scheme == 'https' %}
        # The console's own certificate on loopback is self-signed or names
        # another host; the hop never leaves this machine.
        proxy_ssl_verify off;
{% endif %}
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}
