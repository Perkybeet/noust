; PHP-FPM pool for {{ domain }}
; Generated by WASM: rewritten on every deploy, update and activation.
; Readable by root only: the env[] lines below carry the application's .env,
; secrets included, and the FPM master reads this file as root.

[{{ pool }}]
user = {{ user }}
group = {{ group }}

listen = {{ socket }}
listen.owner = {{ user }}
listen.group = {{ listen_group }}
listen.mode = 0660

; Small by default: most servers run several sites, and a pool that is not
; busy should cost next to nothing. The master grows it up to max_children.
pm = dynamic
pm.max_children = {{ max_children }}
pm.start_servers = 1
pm.min_spare_servers = 1
pm.max_spare_servers = 2
pm.max_requests = 500
request_terminate_timeout = 300

; Worker output reaches the FPM log instead of vanishing, and only .php files
; are ever executed, whatever name a request smuggles in.
catch_workers_output = yes
security.limit_extensions = .php

php_admin_value[memory_limit] = {{ memory_limit }}
php_admin_value[upload_max_filesize] = {{ max_upload }}
php_admin_value[post_max_size] = {{ max_upload }}

; The application's environment, single-quoted so FPM expands nothing in it.
; clear_env stays on: a worker sees these and nothing of the master's.
clear_env = yes
{% for key, value in env %}
env[{{ key }}] = '{{ value }}'
{% endfor %}
