; PHP-FPM pool for {{ domain }}
; Generated by WASM: rewritten on every deploy, update and activation.
; Readable by root only: the env[] lines below carry the application's .env,
; secrets included, and the FPM master reads this file as root.

[{{ pool }}]
user = {{ user }}
group = {{ group }}

listen = {{ socket }}
listen.owner = {{ user }}
listen.group = {{ listen_group }}
listen.mode = 0660

; Small by default: most servers run several sites, and a pool that is not
; busy should cost next to nothing. The master grows it up to max_children.
pm = dynamic
pm.max_children = {{ max_children }}
pm.start_servers = 1
pm.min_spare_servers = 1
pm.max_spare_servers = 2
pm.max_requests = 500
request_terminate_timeout = 300

; Worker output reaches the FPM log instead of vanishing, and only .php files
; are ever executed, whatever name a request smuggles in.
catch_workers_output = yes
security.limit_extensions = .php

php_admin_value[memory_limit] = {{ memory_limit }}
php_admin_value[upload_max_filesize] = {{ max_upload }}
php_admin_value[post_max_size] = {{ max_upload }}

; Every WASM pool runs as the same service user, so nothing but this keeps one
; application's PHP from opening another's files: a path traversal or a file
; inclusion bug stops at its own directory. It does not contain code that can
; run programs (exec, proc_open); separate users per pool would, and are not
; done yet. /tmp stays readable for libraries that hard-code it; PHP's own
; temporary files, uploads and sessions go to the pool's private directory
; instead, so no other pool can read a session.
php_admin_value[open_basedir] = {{ open_basedir }}
php_admin_value[sys_temp_dir] = {{ tmp_dir }}
php_admin_value[upload_tmp_dir] = {{ tmp_dir }}
php_admin_value[session.save_path] = {{ tmp_dir }}
; Debian turns PHP's session collection off and cleans only its default
; directory from cron: this one is collected by PHP itself.
php_admin_value[session.gc_probability] = 1

; The application's environment, single-quoted so the INI parser reads it
; literally; values starting with '$' are refused, since FPM would replace
; them with its own environment variable of that name.
; clear_env stays on: a worker sees these and nothing of the master's.
clear_env = yes
{% for key, value in env %}
env[{{ key }}] = '{{ value }}'
{% endfor %}
