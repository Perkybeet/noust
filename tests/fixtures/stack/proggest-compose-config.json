{
  "name": "proggest",
  "services": {
    "backend": {
      "build": {
        "context": "/var/www/apps/proggest",
        "dockerfile": "apps/erp-backend/Dockerfile",
        "args": {
          "SENTRY_AUTH_TOKEN": "",
          "SENTRY_RELEASE": ""
        }
      },
      "container_name": "proggest-backend",
      "depends_on": {
        "postgres": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "AWS_ACCESS_KEY_ID": "",
        "AWS_REGION": "eu-south-2",
        "AWS_S3_BUCKET": "proggest-storage-prod",
        "AWS_SECRET_ACCESS_KEY": "",
        "BULL_BOARD_PASSWORD": "dummy-bull-board-password",
        "BULL_BOARD_USER": "admin",
        "CORS_ORIGIN": "https://proggest.example,https://partes.proggest.example",
        "DATABASE_URL": "postgresql://proggest:dummy-db-password@postgres:5432/proggest",
        "FIREBASE_CLIENT_EMAIL": "",
        "FIREBASE_PRIVATE_KEY": "",
        "FIREBASE_PROJECT_ID": "",
        "FRONTEND_URL": "https://proggest.example",
        "INTEGRATION_ENCRYPTION_KEY": "",
        "INTERNAL_API_KEY": "dummy-internal-api-key",
        "JWT_EXPIRES_IN": "1h",
        "JWT_SECRET": "dummy-jwt-secret",
        "MAIL_FROM": "noreply@proggest.example",
        "NODE_ENV": "production",
        "PASSKEY_ORIGINS": "https://proggest.example",
        "PASSKEY_RP_ID": "proggest.example",
        "PERSONNEL_ENCRYPTION_KEY": "dummy-personnel-key",
        "PORT": "3000",
        "PUBLIC_BASE_URL": "https://proggest.example",
        "REDIS_DB": "0",
        "REDIS_HOST": "redis",
        "REDIS_PASSWORD": "dummy-redis-password",
        "REDIS_PORT": "6379",
        "SENTRY_DSN": "",
        "SENTRY_RELEASE": "",
        "SMTP_HOST": "smtp.example",
        "SMTP_PASS": "dummy-smtp-password",
        "SMTP_PORT": "587",
        "SMTP_USER": "smtp-user",
        "STORAGE_TYPE": "s3",
        "TWO_FACTOR_ENCRYPTION_KEY": "dummy-two-factor-key"
      },
      "group_add": [
        "999"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://localhost:3000/api/v1/health"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "40s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "proggest-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3000,
          "published": "3000",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "bind",
          "source": "/var/run/docker.sock",
          "target": "/var/run/docker.sock",
          "read_only": true,
          "bind": {
            "create_host_path": true
          }
        }
      ]
    },
    "frontend": {
      "build": {
        "context": "/var/www/apps/proggest",
        "dockerfile": "apps/web-gateway/Dockerfile",
        "args": {
          "NEXT_PUBLIC_API_URL": "https://proggest.example/api/v1",
          "NEXT_PUBLIC_APP_VERSION": "0.12.0",
          "NEXT_PUBLIC_GOOGLE_MAPS_API_KEY": "",
          "NEXT_PUBLIC_SENTRY_DSN": "",
          "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY": "",
          "SENTRY_AUTH_TOKEN": "",
          "SENTRY_RELEASE": ""
        }
      },
      "container_name": "proggest-frontend",
      "depends_on": {
        "backend": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "environment": {
        "API_GATEWAY_URL": "http://backend:3000/api/v1",
        "AUTH_COOKIE_DOMAIN": ".proggest.example",
        "AUTH_GOOGLE_ID": "",
        "AUTH_GOOGLE_SECRET": "",
        "AUTH_MICROSOFT_ID": "",
        "AUTH_MICROSOFT_SECRET": "",
        "AUTH_MICROSOFT_TENANT_ID": "common",
        "AUTH_SECRET": "dummy-auth-secret",
        "AUTH_TRUST_HOST": "true",
        "INTERNAL_API_KEY": "dummy-internal-api-key",
        "NEXTAUTH_SECRET": "dummy-auth-secret",
        "NEXTAUTH_URL": "https://proggest.example",
        "NEXT_PUBLIC_API_URL": "https://proggest.example/api/v1",
        "NEXT_PUBLIC_SENTRY_DSN": "",
        "NODE_ENV": "production",
        "SENTRY_RELEASE": ""
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:3001/api/health"
        ],
        "timeout": "10s",
        "interval": "30s",
        "retries": 3,
        "start_period": "40s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "proggest-network": null
      },
      "ports": [
        {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 3001,
          "published": "3001",
          "protocol": "tcp"
        }
      ],
      "restart": "unless-stopped"
    },
    "postgres": {
      "container_name": "proggest-postgres",
      "environment": {
        "POSTGRES_DB": "proggest",
        "POSTGRES_PASSWORD": "dummy-db-password",
        "POSTGRES_USER": "proggest"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U proggest -d proggest"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5
      },
      "image": "postgres:16-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "proggest-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ]
    },
    "redis": {
      "command": [
        "redis-server",
        "--requirepass",
        "dummy-redis-password",
        "--appendonly",
        "yes"
      ],
      "container_name": "proggest-redis",
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "-a",
          "dummy-redis-password",
          "ping"
        ],
        "timeout": "5s",
        "interval": "10s",
        "retries": 5
      },
      "image": "redis:7-alpine",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-file": "3",
          "max-size": "10m"
        }
      },
      "networks": {
        "proggest-network": null
      },
      "restart": "unless-stopped",
      "volumes": [
        {
          "type": "volume",
          "source": "redisdata",
          "target": "/data",
          "volume": {}
        }
      ]
    }
  },
  "networks": {
    "proggest-network": {
      "name": "proggest_proggest-network",
      "driver": "bridge"
    }
  },
  "volumes": {
    "pgdata": {
      "name": "proggest_pgdata"
    },
    "redisdata": {
      "name": "proggest_redisdata"
    }
  }
}
