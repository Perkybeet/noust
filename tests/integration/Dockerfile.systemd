# Ubuntu 24.04 with systemd as PID 1, for the Noust real-machine integration
# harness (tests/integration/run.py).
#
# This is the standard "systemd in Docker" pattern: install systemd itself,
# mask the units that only make sense on real hardware (getty, console,
# udev triggers that never fire without real devices), and let /sbin/init
# run as PID 1. The container must be started with --privileged
# --cgroupns=host and the host cgroup filesystem bind-mounted read-write, plus
# tmpfs mounts for /run and /run/lock - run.py does all of that.
#
# rclone is installed for the remote backup scenario: Noust uploads to backup
# destinations through it, and the distribution package is what an operator
# installs (core/dependencies.py names it).
#
# PHP-FPM with the extensions WordPress uses, and MariaDB, are installed and
# enabled for the recipe scenarios: Noust writes a pool per PHP application into
# the distribution's FPM and provisions the recipe's database on the local
# server, and both are what an operator installs from the distribution.
#
# Docker Engine and the Compose plugin run inside the container, as its own
# daemon on a dedicated named volume mounted on /var/lib/docker (run.py,
# DOCKER_DATA_VOLUME): overlay-on-overlay needs a real filesystem under it, and
# the volume also keeps the pulled base images between runs. Nothing of the
# host's Docker is shared: no docker.sock, no host volumes or containers.
#
# certbot is deliberately not installed: every scenario that needs a
# certificate is skipped in favour of --no-ssl, because this container has no
# real domain and no path to the public internet's ACME servers.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
        systemd \
        systemd-sysv \
        dbus \
        nginx \
        git \
        curl \
        ca-certificates \
        python3 \
        python3-venv \
        python3-pip \
        nodejs \
        npm \
        sqlite3 \
        procps \
        iproute2 \
        rclone \
        php-fpm \
        php-mysql \
        php-curl \
        php-gd \
        php-mbstring \
        php-xml \
        php-zip \
        php-intl \
        mariadb-server \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Units that assume real hardware or an interactive console. Masking them is
# what keeps `systemctl is-system-running` from sitting in "starting" forever
# waiting for a getty that will never attach to anything in a container.
RUN systemctl mask \
        getty.target \
        getty-static.service \
        console-getty.service \
        systemd-udevd.service \
        systemd-udev-trigger.service \
        systemd-udevd-kernel.socket \
        systemd-udevd-control.socket \
        systemd-modules-load.service \
        systemd-random-seed.service \
        sys-kernel-config.mount \
        sys-kernel-debug.mount \
        sys-kernel-tracing.mount \
        systemd-remount-fs.service \
    && systemctl set-default multi-user.target

# Enabled explicitly: package scripts cannot talk to systemd during a build,
# and the recipe scenarios need both running when the container boots. The
# FPM unit is versioned (php8.3-fpm on 24.04), so it is looked up.
RUN systemctl enable mariadb "$(basename /usr/lib/systemd/system/php*-fpm.service)"

# nginx starts under its own unit once Noust configures a site; the packaged
# default site is removed so it never answers on port 80 before that.
RUN rm -f /etc/nginx/sites-enabled/default

# Docker Engine and the Compose v2 plugin, for the Docker Compose scenarios:
# the distribution's own packages (24.04 packages both, and Noust only needs
# what an operator gets from `apt install docker.io docker-compose-v2`).
# docker-buildx is a Recommends of docker.io that --no-install-recommends
# drops, and Compose builds images through it. This is a second layer, after
# everything above, so adding it did not invalidate the image's cached layers.
RUN apt-get update && apt-get install -y --no-install-recommends \
        docker.io \
        docker-compose-v2 \
        docker-buildx \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# The classic overlay2 store, not the containerd image store that Docker 29
# picks for a fresh data directory: the containerd store keeps images and
# snapshots in /var/lib/containerd, outside the volume run.py mounts on
# /var/lib/docker, so they would be overlay-on-overlay on the container's own
# root filesystem (which does not work) and would not survive between runs.
RUN mkdir -p /etc/docker \
    && printf '{\n  "storage-driver": "overlay2",\n  "features": {"containerd-snapshotter": false}\n}\n' \
        > /etc/docker/daemon.json

# Enabled here for the same reason as mariadb above: package scripts cannot
# talk to systemd during a build, and the scenarios need the daemon running
# when the container boots. Never the host's docker.sock: this daemon is the
# container's own, with its own data directory.
RUN systemctl enable docker.socket docker.service containerd.service

STOPSIGNAL SIGRTMIN+3

CMD ["/sbin/init"]
